UserInputService.JumpRequest:Connect(function()
    if infiniteJumpEnabled then
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end
end)

-- 7. Float
local floatToggle = Instance.new("TextButton")
floatToggle.Parent = PlayerPage
floatToggle.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
floatToggle.Size = UDim2.new(1, -10, 0, 32)
floatToggle.Font = Enum.Font.GothamBold
floatToggle.Text = "Float: OFF"
floatToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
floatToggle.TextSize = 12
floatToggle.LayoutOrder = 7
Instance.new("UICorner", floatToggle).CornerRadius = UDim.new(0, 6)

local floatPart = nil

local function removeFloatPart()
    if floatPart then
        floatPart:Destroy()
        floatPart = nil
    end
end

floatToggle.MouseButton1Click:Connect(function()
    floatEnabled = not floatEnabled
    if floatEnabled then
        floatToggle.Text = "Float: ON"
        floatToggle.TextColor3 = Color3.fromRGB(100, 255, 100)
        floatToggle.BackgroundColor3 = Color3.fromRGB(35, 60, 35)
        
        if not floatPart then
            floatPart = Instance.new("Part")
            floatPart.Name = "DeltaHubFloatBlock"
            floatPart.Size = Vector3.new(4, 1, 4)
            floatPart.Transparency = 0.3
            floatPart.Color = Color3.fromRGB(0, 170, 255)
            floatPart.Material = Enum.Material.SmoothPlastic
            floatPart.Anchored = true
            floatPart.CanCollide = true
            floatPart.Parent = Workspace
        end
    else
        floatToggle.Text = "Float: OFF"
        floatToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
        floatToggle.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
        removeFloatPart()
    end
end)

-- 8. Slider Float
local sliderContainer = Instance.new("Frame")
sliderContainer.Parent = PlayerPage
sliderContainer.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
sliderContainer.Size = UDim2.new(1, -10, 0, 32)
sliderContainer.LayoutOrder = 8
Instance.new("UICorner", sliderContainer).CornerRadius = UDim.new(0, 6)

local sliderFill = Instance.new("Frame")
sliderFill.Parent = sliderContainer
sliderFill.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
sliderFill.Size = UDim2.new(0, 0, 1, 0)
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 6)

local sliderLabel = Instance.new("TextLabel")
sliderLabel.Parent = sliderContainer
sliderLabel.BackgroundTransparency = 1
sliderLabel.Size = UDim2.new(1, 0, 1, 0)
sliderLabel.Font = Enum.Font.GothamBold
sliderLabel.Text = "Distancia Float: 3.0 Studs"
sliderLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
sliderLabel.TextSize = 12

local sliding = false

local function updateSlider(input)
    local pos = sliderContainer.AbsolutePosition.X
    local size = sliderContainer.AbsoluteSize.X
    local mouseX = input.Position.X
    local relativeX = math.clamp(mouseX - pos, 0, size)
    local percentage = relativeX / size
    
    floatDistance = math.floor((3.0 + (percentage * 3.0)) * 10 + 0.5) / 10
    sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    sliderLabel.Text = string.format("Distancia Float: %.1f Studs", floatDistance)
end

sliderContainer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

