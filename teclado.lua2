    local function getClosestPointIndex(path, targetPos)
        local min = math.huge
        local idx = #path
        for i, pt in ipairs(path) do
            local pos = typeof(pt) == "Vector3" and pt or pt.Position
            local d = (pos - targetPos).Magnitude
            if d < min then
                min = d
                idx = i
            end
        end
        return idx
    end

