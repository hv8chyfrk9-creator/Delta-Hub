    local function cleanObject(obj)
        pcall(function()
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "lava") then
                obj:Destroy()
                return
            end
            if nameLower == "hitbox" then
                local parent = obj.Parent
                if parent and string.lower(parent.Name):find("npc") then
                    obj:Destroy()
                end
            end
        end)
    end

    pcall(function()
        for _, obj in pairs(Workspace:GetDescendants()) do cleanObject(obj) end
    end)
    Workspace.DescendantAdded:Connect(function(obj) cleanObject(obj) end)

