-- 1. LIMPIEZA AUTOMÁTICA Y ANTI-LAG AVANZADO (Por default al ejecutar)
----------------------------------------------------
local function cleanObject(obj)
    pcall(function()
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, "lava") or string.find(nameLower, "movingwall") or nameLower == "keycaps" then
            obj:Destroy()
            return
        end
        if nameLower == "hitbox" then
            local parent = obj.Parent
            if parent and string.lower(parent.Name):find("npc") then
                obj:Destroy()
            end
        end
    end)
end

-- Limpieza inicial de obstáculos, texturas pesadas y materiales
pcall(function()
    for _, obj in pairs(Workspace:GetDescendants()) do
        cleanObject(obj)
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        elseif obj:IsA("Texture") or obj:IsA("Decal") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj:Destroy()
        end
    end
end)

-- Conexión dinámica para nuevos objetos que aparezcan en el Workspace
Workspace.DescendantAdded:Connect(function(obj)
    cleanObject(obj)
    pcall(function()
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        elseif obj:IsA("Texture") or obj:IsA("Decal") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj:Destroy()
        end
    end)
end)

-- Optimización de iluminación y efectos visuales pesados (manteniendo máxima distancia de renderizado)
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Sky") then
            effect.Enabled = false
        end
    end
end)

-- Forzar la distancia de renderizado al MÁXIMO posible
pcall(function()
    if player and player.ReplicationFocus then
        player.ReplicationFocus = nil
    end
    -- Establecer la calidad y distancia de renderizado al nivel máximo permitido
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level21
    pcall(function()
        Workspace.StreamingEnabled = false -- Desactiva el streaming para cargar todo el mapa por completo a máxima distancia
    end)
    pcall(function()
        if UserSettings():GetService("UserGameSettings") then
            UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualityLevel.Level21
        end
    end)
end)

