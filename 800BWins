local autoWinEnabled = false
local noclipConnection = nil

local function setNoclip(state)
    local char = player.Character
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function findRemoteEvent()
    local targetName = "RequestCheckpointTp"
    local found = ReplicatedStorage:FindFirstChild(targetName)
    if found and found:IsA("RemoteEvent") then
        return found
    end
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant.Name == targetName and descendant:IsA("RemoteEvent") then
            return descendant
        end
    end
    return nil
end

AutoWinBtn.MouseButton1Click:Connect(function()
    autoWinEnabled = not autoWinEnabled
    if autoWinEnabled then
        AutoWinBtn.Text = "autowin: ON"
        AutoWinBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(40, 80, 40)
        setNoclip(true)

        task.spawn(function()
            while autoWinEnabled do
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum then
                    -- 1. Ejecutar el RemoteEvent
                    StatusLabel.Text = "Estado: Disparando RemoteEvent..."
                    local remoteEvent = findRemoteEvent()
                    if remoteEvent then
                        pcall(function()
                            remoteEvent:FireServer(13, "wins")
                        end)
                    end

                    -- 2. Esperar 0.1 segundos
                    task.wait(0.1)

                    -- 3. Ejecutar el recorrido por los puntos
                    StatusLabel.Text = "Estado: Ejecutando recorrido..."
                    hrp.CFrame = CFrame.new(ultimaFasePoints[1])
                    task.wait(0.05)

                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = Vector3.new(0, 0, 0)
                    bv.Parent = hrp
                    hum.PlatformStand = true

                    local recorridoVelocidad = tonumber(SpeedBox.Text) or 200
                    for i = 1, #ultimaFasePoints do
                        local targetPos = ultimaFasePoints[i]
                        
                        while true do
                            local dt = RunService.RenderStepped:Wait()
                            local currentPos = hrp.Position
                            local distance = (targetPos - currentPos).Magnitude
                            local step = recorridoVelocidad * dt
                            
                            if distance <= step + 0.5 then
                                hrp.CFrame = CFrame.new(targetPos)
                                break
                            else
                                bv.Velocity = (targetPos - currentPos).Unit * recorridoVelocidad
                                hrp.CFrame = CFrame.new(currentPos, targetPos)
                            end
                        end
                    end

                    if bv and bv.Parent then bv:Destroy() end
                    hum.PlatformStand = false

                    -- 4. Hacer tween hacia WinBlock46
                    StatusLabel.Text = "Estado: Haciendo tween a WinBlock46..."
                    local targetTweenPos = nil
                    pcall(function()
                        local foundObj = Workspace:FindFirstChild("WinBlock46", true)
                        if foundObj then
                            if foundObj:IsA("BasePart") then
                                targetTweenPos = foundObj.Position + Vector3.new(0, 3, 0)
                            elseif foundObj:IsA("Model") and foundObj.PrimaryPart then
                                targetTweenPos = foundObj.PrimaryPart.Position + Vector3.new(0, 3, 0)
                            end
                        end
                    end)

                    if not targetTweenPos then
                        targetTweenPos = ultimaFasePoints[#ultimaFasePoints] + Vector3.new(0, 5, 0)
                    end

                    local distanceToWin = (targetTweenPos - hrp.Position).Magnitude
                    local tweenDuration = math.clamp(distanceToWin / 350, 0.2, 1.5)
                    
                    local tween = TweenService:Create(hrp, TweenInfo.new(tweenDuration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetTweenPos)})
                    tween:Play()
                    tween.Completed:Wait()

                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                    -- 5. Esperar 0.1 segundos después de tocar WinBlock46 antes de evaluar el ciclo
                    StatusLabel.Text = "Estado: Ciclo completado, esperando..."
                    task.wait(0.1)
                else
                    task.wait(0.5)
                end
            end
            
            StatusLabel.Text = "Estado: Inactivo (Anti-Lag Activo)"
            setNoclip(false)
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hrp:FindFirstChildOfClass("BodyVelocity") then
                    hrp:FindFirstChildOfClass("BodyVelocity"):Destroy()
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = false end
            end
        end)
    else
        AutoWinBtn.Text = "autowin: OFF"
        AutoWinBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    end
end)
