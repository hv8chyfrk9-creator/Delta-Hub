AutoExecBtn.MouseButton1Click:Connect(function()
    config.autoExecute = not config.autoExecute
    saveConfig(config)

    if config.autoExecute then
        AutoExecBtn.Text = "Auto Execute: ON"
        AutoExecBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        AutoExecBtn.BackgroundColor3 = Color3.fromRGB(40, 80, 40)
    else
        AutoExecBtn.Text = "Auto Execute: OFF"
        AutoExecBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        AutoExecBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        StatusLabel.Visible = false
        ButtonsFrame.Visible = true
        SettingsFrame.Visible = false
        Title.Text = selectorTitle()
    end
end)

if config.autoExecute then
    ButtonsFrame.Visible = false
    SettingsFrame.Visible = false
    StatusLabel.Visible = true

    task.spawn(function()
        local secondsElapsed = 0

        StatusLabel.Text = "Buscando juego..."
        while secondsElapsed < 1 do
            if not ScreenGui.Parent then return end
            if not autoExecutePaused then secondsElapsed = secondsElapsed + 0.1 end
            task.wait(0.1)
        end

        StatusLabel.Text = "Juego encontrado"
        secondsElapsed = 0
        while secondsElapsed < 1 do
            if not ScreenGui.Parent then return end
            if not autoExecutePaused then secondsElapsed = secondsElapsed + 0.1 end
            task.wait(0.1)
        end

        StatusLabel.Text = "Cargando script..."
        secondsElapsed = 0
        while secondsElapsed < 2 do
            if not ScreenGui.Parent then return end
            if not autoExecutePaused then secondsElapsed = secondsElapsed + 0.1 end
            task.wait(0.1)
        end

        StatusLabel.Text = "Script cargado completamente"
        secondsElapsed = 0
        while secondsElapsed < 1 do
            if not ScreenGui.Parent then return end
            if not autoExecutePaused then secondsElapsed = secondsElapsed + 0.1 end
            task.wait(0.1)
        end

        if not config.autoExecute then return end

        local currentId = game.GameId
        local placeId = game.PlaceId
        local url

        if placeId == GALAXIA_2_PLACE_ID then
            url = URL_GALAXIA2
        elseif currentId == ID_TECLADO or placeId == ID_TECLADO then
            url = URL_MUNDO3
        elseif currentId == ID_MONO or placeId == ID_MONO then
            url = URL_MONO
        end

        ScreenGui:Destroy()
        if url then
            loadRemote(url)
        end
    end)
end
