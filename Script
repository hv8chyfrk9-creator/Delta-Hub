local function arm(btn, url)
    btn.MouseButton1Click:Connect(function()
        btn.Text = "Cargando..."
        btn.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        task.wait(0.4)
        ScreenGui:Destroy()
        loadRemote(url)
    end)
end

