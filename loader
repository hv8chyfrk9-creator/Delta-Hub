local function notify(msg, ok)
    warn("[Delta Hub] " .. tostring(msg))
    pcall(function()
        local sg = Instance.new("ScreenGui")
        sg.Name = "DeltaHubNotify"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 300000
        sg.Parent = PlayerGui
        local t = Instance.new("TextLabel")
        t.Parent = sg
        t.Size = UDim2.new(0, 320, 0, 70)
        t.Position = UDim2.new(0.5, -160, 0.12, 0)
        t.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        t.TextColor3 = ok and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 120, 120)
        t.Font = Enum.Font.GothamBold
        t.TextSize = 12
        t.TextWrapped = true
        t.Text = tostring(msg)
        Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)
        task.delay(7, function() if sg then sg:Destroy() end end)
    end)
end

local function httpGet(pathOrUrl)
    local url = pathOrUrl
    if not string.find(pathOrUrl, "https://", 1, true) then
        url = BASE .. pathOrUrl .. "?t=" .. tostring(math.floor(tick()))
    else
        url = pathOrUrl .. (string.find(pathOrUrl, "?", 1, true) and "&" or "?") .. "t=" .. tostring(math.floor(tick()))
    end
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or type(body) ~= "string" or #body < 20 then
        return nil, "HttpGet fallo: " .. tostring(body)
    end
    if string.sub(body, 1, 9) == "<!DOCTYPE" or string.sub(body, 1, 6) == "<html>" then
        return nil, "GitHub HTML (archivo faltante?): " .. tostring(pathOrUrl)
    end
    return body, nil
end

local function loadstringRun(src, label)
    local fn, err = loadstring(src)
    if not fn then
        notify("Error loadstring (" .. tostring(label) .. "): " .. tostring(err), false)
        return false
    end
    local ok, runErr = pcall(fn)
    if not ok then
        notify("Error al correr (" .. tostring(label) .. "): " .. tostring(runErr), false)
        return false
    end
    return true
end

local function loadHallowenMultipart()
    if getgenv then
        getgenv().DeltaHubActive = true
        getgenv().DeltaHubForceLoad = true
        getgenv().DeltaHubCurrentUrl = "hallowen-multipart"
    end
    clearActiveGuis()

    local sg = Instance.new("ScreenGui")
    sg.Name = "DeltaHubHWLoad"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 250000
    sg.Parent = PlayerGui
    local lbl = Instance.new("TextLabel")
    lbl.Parent = sg
    lbl.Size = UDim2.new(0, 300, 0, 60)
    lbl.Position = UDim2.new(0.5, -150, 0.12, 0)
    lbl.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    lbl.TextColor3 = Color3.fromRGB(120, 255, 140)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextWrapped = true
    lbl.Text = "Hallowen: bajando 1/3..."
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 8)

    local ok, err = pcall(function()
        local chunks = {}
        for i = 1, 3 do
            lbl.Text = "Hallowen: bajando " .. i .. "/3..."
            local body, e = httpGet("HW_p" .. i .. ".lua")
            if not body then
                error(e or ("No se pudo bajar HW_p" .. i .. ".lua"))
            end
            table.insert(chunks, body)
            task.wait(0.03)
        end
        lbl.Text = "Hallowen: uniendo y ejecutando..."
        local src = table.concat(chunks, "\n")
        local fn, e = loadstring(src)
        if not fn then
            error("loadstring: " .. tostring(e))
        end
        fn()
    end)

    if ok then
        lbl.Text = "Hallowen: cargado"
        lbl.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.delay(2.5, function()
            if sg then sg:Destroy() end
        end)
    else
        lbl.Text = "ERROR: " .. tostring(err)
        lbl.TextColor3 = Color3.fromRGB(255, 120, 120)
        notify(tostring(err), false)
    end
end

local function loadRemote(url)
    if getgenv then
        getgenv().DeltaHubActive = true
        local same = getgenv().DeltaHubCurrentUrl == url and (guiExists("DeltaHubMinimal") or guiExists("DeltaHubCustom"))
        getgenv().DeltaHubSkipAssets = same and true or false
        getgenv().DeltaHubAntilagWasOn = same and getgenv().DeltaHubAntilagOn or false
        if same then
            clearActiveGuis()
        end
        getgenv().DeltaHubCurrentUrl = url
    else
        clearActiveGuis()
    end
    local body, e = httpGet(url)
    if not body then
        notify(e or "No se pudo bajar el script", false)
        return
    end
    loadstringRun(body, "remote")
end

local function isHallowen()
    return game.PlaceId == HALLOWEN_PLACE_ID
end

local function keyboardUrl()
    local placeId = game.PlaceId
    if placeId == GALAXIA_2_PLACE_ID then
        return URL_GALAXIA2
    elseif placeId == MUNDO_3_PLACE_ID then
        return URL_MUNDO3
    elseif placeId == HALLOWEN_PLACE_ID then
        return "hallowen-multipart"
    end
    return nil
end

local function autoUrl()
    local placeId = game.PlaceId
    if placeId == GALAXIA_2_PLACE_ID then
        return URL_GALAXIA2
    elseif placeId == MUNDO_3_PLACE_ID then
        return URL_MUNDO3
    elseif placeId == HALLOWEN_PLACE_ID then
        return "hallowen-multipart"
    elseif placeId == ID_MONO then
        return URL_MONO
    end
    return nil
end

