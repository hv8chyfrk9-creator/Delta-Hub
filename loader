local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Archivo de configuración local para guardar "Ejecución Rápida"
local CONFIG_FILE = "DeltaHub_LoaderConfig.json"
local fastExecutionEnabled = false

pcall(function()
	if isfile and isfile(CONFIG_FILE) then
		local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
		if data and data.fastExecution ~= nil then
			fastExecutionEnabled = data.fastExecution
		end
	end
end)

local function saveConfig()
	pcall(function()
		if writefile then
			writefile(CONFIG_FILE, HttpService:JSONEncode({ fastExecution = fastExecutionEnabled }))
		end
	end)
end

-- Destruir loader previo si existe
if playerGui:FindFirstChild("DeltaHubLoaderGui") then
	playerGui.DeltaHubLoaderGui:Destroy()
end

