local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local configFileName = "DeltaHub_Data.json"

local function saveConfig(data)
    pcall(function()
        writefile(configFileName, HttpService:JSONEncode(data))
    end)
end

local function loadConfig()
    local success, result = pcall(function()
        if isfile and isfile(configFileName) then
            return HttpService:JSONDecode(readfile(configFileName))
        end
    end)
    if success and result then
        result.visits = (result.visits or 0) + 1
        saveConfig(result)
        return result
    end

    local initialData = { autoExecute = false, visits = 1 }
    saveConfig(initialData)
    return initialData
end

local config = loadConfig()

local ID_TECLADO = 9584852943
local ID_MONO = 10144280947
local GALAXIA_2_PLACE_ID = 75012837977315

local URL_MUNDO3 = "https://raw.githubusercontent.com/hv8chyfrk9-creator/Delta-Hub/refs/heads/main/Mundo%203%20KeyBoard.lua"
local URL_GALAXIA2 = "https://raw.githubusercontent.com/hv8chyfrk9-creator/Delta-Hub/refs/heads/main/galaxia%202%20Keyboard.lua"
local URL_MONO = "https://raw.githubusercontent.com/hv8chyfrk9-creator/Delta-Hub/refs/heads/main/Escape%20del%20mono.lua"
local URL_WINS = "https://raw.githubusercontent.com/hv8chyfrk9-creator/Delta-Hub/refs/heads/main/800BWins"

local function guiExists(name)
    return CoreGui:FindFirstChild(name) ~= nil or PlayerGui:FindFirstChild(name) ~= nil
end

local function hasActiveScript()
    if getgenv and getgenv().DeltaHubActive then
        return true
    end
    return guiExists("DeltaHubMinimal") or guiExists("DeltaHubCustom")
end

local function clearActiveGuis()
    for _, name in ipairs({"DeltaHubMinimal", "DeltaHubCustom", "DeltaHubLoader"}) do
        local a = CoreGui:FindFirstChild(name)
        local b = PlayerGui:FindFirstChild(name)
        if a then a:Destroy() end
        if b then b:Destroy() end
    end
end

local function loadRemote(url)
    if getgenv then
        getgenv().DeltaHubActive = true
        local same = getgenv().DeltaHubCurrentUrl == url and (guiExists("DeltaHubMinimal") or guiExists("DeltaHubCustom"))
        getgenv().DeltaHubSkipAssets = same and true or false
        getgenv().DeltaHubAntilagWasOn = same and getgenv().DeltaHubAntilagOn or false
        if same then
            clearActiveGuis()
        end
        getgenv().DeltaHubCurrentUrl = url
    else
        clearActiveGuis()
    end
    loadstring(game:HttpGet(url))()
end

local function keyboardUrl()
    local placeId = game.PlaceId
    local currentId = game.GameId
    if placeId == GALAXIA_2_PLACE_ID then
        return URL_GALAXIA2
    end
    if currentId == ID_TECLADO or placeId == ID_TECLADO or placeId ~= ID_MONO then
        return URL_MUNDO3
    end
    return URL_MUNDO3
end

local function autoUrl()
    local placeId = game.PlaceId
    local currentId = game.GameId
    if placeId == GALAXIA_2_PLACE_ID then
        return URL_GALAXIA2
    elseif currentId == ID_TECLADO or placeId == ID_TECLADO then
        return URL_MUNDO3
    elseif currentId == ID_MONO or placeId == ID_MONO then
        return URL_MONO
    end
    return nil
end

