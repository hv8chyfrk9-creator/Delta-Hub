-- ==========================================
-- LÓGICA DE SECUENCIA Y CARGA DE REPOS
-- ==========================================
task.spawn(function()
	local t1, t2, t3, t4, t5, t6, t7, t8 = 1, 0.5, 1, 0.5, 1, 0.5, 1, 0.5
	if fastExecutionEnabled then
		local scale = 2.0 / (t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8)
		t1, t2, t3, t4, t5, t6, t7, t8 = t1 * scale, t2 * scale, t3 * scale, t4 * scale, t5 * scale, t6 * scale, t7 * scale, t8 * scale
	end

	local function updateStep(progress, text, subText, waitTime)
		if loaderDestroyed then
			return false
		end
		StatusLabel.Text = text
		SubStatusLabel.Text = subText
		BarFill.Size = UDim2.new(progress, 0, 1, 0)
		task.wait(waitTime)
		return not loaderDestroyed
	end

	if not updateStep(0.12, "Buscando Juego", "Verificando GameId...", t1) then return end
	if not updateStep(0.25, "Juego encontrado", "GameId validado con éxito.", t2) then return end
	if not updateStep(0.37, "Buscando mundo", "Identificando PlaceId actual...", t3) then return end
	if not updateStep(0.50, "Mundo encontrado", "PlaceId reconocido en el sistema.", t4) then return end
	if not updateStep(0.62, "Buscando script", "Localizando repositorio en GitHub...", t5) then return end
	if not updateStep(0.75, "Script encontrado", "Conexión con el repositorio establecida.", t6) then return end
	if not updateStep(0.87, "Cargando script", "Descargando código fuente...", t7) then return end
	if not updateStep(1.00, "Script cargado completamente", "Iniciando interfaz...", t8) then return end

	if loaderDestroyed then return end

	local TARGET_GAME_ID = 9584852943
	if tostring(game.GameId) ~= tostring(TARGET_GAME_ID) then
		StatusLabel.Text = "Error: GameId no compatible"
		SubStatusLabel.Text = "Este script no pertenece a este juego."
		BarFill.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		return
	end

	-- Solo 3 mundos: Hallowen, Galaxia 2 (G2), Mundo 3
	local placeToRepoUrl = {
		[128614435234859] = "https://raw.githubusercontent.com/hv8chyfrk9-creator/Event-Hallowen/main/init.lua",
		[75012837977315] = "https://raw.githubusercontent.com/hv8chyfrk9-creator/mundo-1-G2/main/init.lua",
		[93411036959889] = "https://raw.githubusercontent.com/hv8chyfrk9-creator/mundo-3/main/init.lua",
	}

	local targetUrl = placeToRepoUrl[game.PlaceId]

	if not targetUrl then
		StatusLabel.Text = "Mundo no registrado"
		SubStatusLabel.Text = "PlaceId actual (" .. tostring(game.PlaceId) .. ") no tiene script asignado."
		BarFill.BackgroundColor3 = Color3.fromRGB(255, 160, 50)
		return
	end

	StatusLabel.Text = "Inyectando script..."
	SubStatusLabel.Text = "Ejecutando módulo del mundo..."

	local success, scriptContent = pcall(function()
		return game:HttpGet(targetUrl)
	end)

	if success and scriptContent then
		local runSuccess, runErr = pcall(function()
			loadstring(scriptContent)()
		end)

		if runSuccess then
			ScreenGui:Destroy()
		else
			StatusLabel.Text = "Error al ejecutar script"
			SubStatusLabel.Text = tostring(runErr):sub(1, 50)
			BarFill.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		end
	else
		StatusLabel.Text = "Error de descarga"
		SubStatusLabel.Text = "No se pudo conectar con GitHub (revisa el archivo init.lua)."
		BarFill.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	end
end)
