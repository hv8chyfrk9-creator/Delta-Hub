local function selectorTitle()
    if config.visits == 1 then
        return "Delta Hub | Loader"
    elseif config.visits == 2 then
        return "Hola de nuevo, " .. LocalPlayer.Name
    end
    return "Delta Hub | Visita #" .. config.visits
end

local Body = Instance.new("Frame")
Body.Parent = MainFrame
Body.BackgroundTransparency = 1
Body.Position = UDim2.new(0, 16, 0, 48)
Body.Size = UDim2.new(1, -32, 1, -60)

local function clearBody()
    for _, child in ipairs(Body:GetChildren()) do
        child:Destroy()
    end
end

local function makeList()
    local layout = Instance.new("UIListLayout")
    layout.Parent = Body
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    return layout
end

local function makeButton(text, order, color)
    local btn = Instance.new("TextButton")
    btn.Parent = Body
    btn.BackgroundColor3 = color or Color3.fromRGB(45, 45, 55)
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.TextWrapped = true
    btn.LayoutOrder = order
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

local function makeLabel(text, order, height)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = Body
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, height or 48)
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 230, 235)
    lbl.TextSize = 13
    lbl.TextWrapped = true
    lbl.LayoutOrder = order
    return lbl
end

local showWins = false

local function openSelector()
    clearBody()
    makeList()
    Title.Text = selectorTitle()
    MainFrame.Size = UDim2.new(0, 310, 0, showWins and 280 or 230)

    local teclado = makeButton("Teclado", 1)
    teclado.MouseButton1Click:Connect(function()
        teclado.Text = "Cargando..."
        task.wait(0.3)
        local url = keyboardUrl()
        ScreenGui:Destroy()
        loadRemote(url)
    end)

    local mono = makeButton("Escape del mono", 2)
    mono.MouseButton1Click:Connect(function()
        mono.Text = "Cargando..."
        task.wait(0.3)
        ScreenGui:Destroy()
        loadRemote(URL_MONO)
    end)

    if showWins then
        local wins = makeButton("800 Billones de Wins", 3, Color3.fromRGB(70, 55, 30))
        wins.MouseButton1Click:Connect(function()
            wins.Text = "Cargando..."
            task.wait(0.3)
            ScreenGui:Destroy()
            loadRemote(URL_WINS)
        end)
    end

    local ajustes = makeButton("Ajustes", 4, Color3.fromRGB(55, 55, 65))
    ajustes.MouseButton1Click:Connect(function()
        openSettings()
    end)
end

function openSettings()
    clearBody()
    makeList()
    Title.Text = "Delta Hub | Ajustes"
    MainFrame.Size = UDim2.new(0, 310, 0, 200)

    local auto = makeButton(config.autoExecute and "Auto Execute: ON" or "Auto Execute: OFF", 1, config.autoExecute and Color3.fromRGB(40, 80, 40) or Color3.fromRGB(45, 45, 55))
    auto.TextColor3 = config.autoExecute and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    auto.MouseButton1Click:Connect(function()
        config.autoExecute = not config.autoExecute
        saveConfig(config)
        openSettings()
    end)

    local back = makeButton("Volver", 2, Color3.fromRGB(55, 55, 65))
    back.MouseButton1Click:Connect(openSelector)
end

local function openActivePrompt()
    clearBody()
    makeList()
    Title.Text = "Script activo"
    MainFrame.Size = UDim2.new(0, 310, 0, 230)
    makeLabel("Ya estas usando un script activo de Delta Hub. Quieres cerrar esta pestaña o cargar otro?", 1, 56)

    local cerrar = makeButton("Cerrar pestaña", 2, Color3.fromRGB(90, 50, 50))
    cerrar.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    local otro = makeButton("Cargar otro", 3, Color3.fromRGB(40, 80, 40))
    otro.MouseButton1Click:Connect(function()
        showWins = true
        openSelector()
    end)
end

local active = hasActiveScript()
if config.autoExecute and active then
    openActivePrompt()
elseif config.autoExecute then
    clearBody()
    Title.Text = "Auto Execute"
    local status = makeLabel("Buscando juego...", 1, 40)
    task.spawn(function()
        local steps = {
            {1, "Buscando juego..."},
            {1, "Juego encontrado"},
            {2, "Cargando script..."},
            {1, "Script cargado completamente"},
        }
        for _, step in ipairs(steps) do
            status.Text = step[2]
            local elapsed = 0
            while elapsed < step[1] do
                if not ScreenGui.Parent then return end
                elapsed += 0.1
                task.wait(0.1)
            end
        end
        if not config.autoExecute then
            openSelector()
            return
        end
        local url = autoUrl()
        ScreenGui:Destroy()
        if url then
            loadRemote(url)
        end
    end)
else
    openSelector()
end
