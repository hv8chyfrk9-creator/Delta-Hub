    end)
end

local active = hasActiveScript()
if config.autoExecute and active then
    openActivePrompt()
elseif config.autoExecute then
    clearBody()
    Title.Text = "Auto Execute"
    local status = makeLabel("Buscando juego...", 1, 40)
    task.spawn(function()
        local steps = {
            {1, "Buscando juego..."},
            {1, "Juego encontrado"},
            {2, "Cargando script..."},
            {1, "Script cargado completamente"},
        }
        for _, step in ipairs(steps) do
            status.Text = step[2]
            local elapsed = 0
            while elapsed < step[1] do
                if not ScreenGui.Parent then return end
                elapsed = elapsed + 0.1
                task.wait(0.1)
            end
        end
        if not config.autoExecute then
            openSelector()
            return
        end
        ScreenGui:Destroy()
        if isHallowen() then
            loadHallowenMultipart()
        else
            local url = autoUrl()
            if url and url ~= "hallowen-multipart" then
                loadRemote(url)
            else
                notify("No hay script para PlaceId " .. tostring(game.PlaceId), false)
            end
        end
    end)
else
    openSelector()
end
